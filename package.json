{
  "name": "harbourline",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @harbourline/web dev",
    "build": "pnpm --recursive --workspace-concurrency=1 build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @harbourline/web test && pnpm --filter @harbourline/domain test && pnpm --filter @harbourline/sync test",
    "db:verify": "node scripts/verify-release2-schema.mjs",
    "multi-currency:verify": "node scripts/verify-multi-currency-production.mjs",
    "pdf:verify": "node scripts/verify-pdf-build.mjs",
    "growth:verify": "node scripts/verify-growth-positioning.mjs",
    "seo:verify": "node scripts/verify-marketing-seo.mjs",
    "db:test": "supabase test db",
    "deploy:verify": "node scripts/verify-beta-deployment-config.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm db:verify && pnpm multi-currency:verify && pnpm growth:verify && pnpm seo:verify && pnpm build && pnpm pdf:verify"
  }
}
