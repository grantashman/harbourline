{
  "name": "harbourline",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @harbourline/web dev",
    "build": "pnpm --recursive --workspace-concurrency=1 build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @harbourline/domain test && pnpm --filter @harbourline/sync test",
    "db:verify": "node scripts/verify-release2-schema.mjs",
    "db:test": "supabase test db",
    "check": "pnpm typecheck && pnpm test && pnpm db:verify && pnpm build"
  }
}
